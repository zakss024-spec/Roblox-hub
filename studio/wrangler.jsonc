{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roblox-hub-studio-cloudflare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "RUNCOMPUTER_BASE_URL": "https://api.runcomputer.cloud/v1",
    "RUNCOMPUTER_MODEL": "deepseek-v4-flash"
  }
}
